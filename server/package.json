{
  "name": "dope-lyrics-server",
  "version": "0.13.0",
  "license": "MIT",
  "module": "src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/app/index.ts",
    "build": "bun build --watch src/app/index.ts",
    "start": "NODE_ENV=production bun src/app/index.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "prisma db seed",
    "import:apple-notes": "bun ./prisma/script/import-apple-notes.ts",
    "ai:probe": "bun ./prisma/script/ai-probe.ts",
    "ai:scratch": "bun ./prisma/script/scratch-probe.ts",
    "reference:tracks": "bun ./prisma/script/reference-shelf-tracks.ts",
    "bot": "bun src/mtcute/index.ts",
    "bot:admin": "BOT_TYPE=admin bun src/mtcute/index.ts",
    "devBot": "concurrently \"bun dev\" \"bun bot:admin\"",
    "start:all": "bun run start & bun run bot",
    "start:admin": "prisma migrate deploy & bun run start & bun run bot:admin",
    "lint": "eslint \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "sort-imports": "eslint --fix \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "fix": "bun run lint:fix && bun run format && bun run typecheck",
    "ci": "bun run migrate && bun run check && bun test",
    "kill-port": "for p in 4000 4001 4002 4003 4004 4005 4006 4007 4008 4009 4071; do pids=$(lsof -ti tcp:$p); [ -n \"$pids\" ] && kill -9 $pids; done"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/swagger": "^1.3.1",
    "@mtcute/bun": "^0.32.8",
    "@mtcute/core": "^0.32.8",
    "@mtcute/dispatcher": "^0.32.8",
    "@mtcute/tl": "^223.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "elysia": "^1.4.31",
    "fflate": "^0.8.3",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "bun-types": "^1.4.4",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "telegram-bot-api-types": "^10.2.0",
    "typescript": "^6.0.3"
  }
}
