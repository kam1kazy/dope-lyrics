{
  "name": "dope-lyrics-server",
  "version": "0.1.0",
  "license": "MIT",
  "module": "src/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "prisma db seed",
    "bot": "bun src/mtcute/index.ts",
    "bot:admin": "BOT_TYPE=admin bun src/mtcute/index.ts",
    "devBot": "concurrently \"bun dev\" \"bun bot:admin\"",
    "start:all": "bun run start & bun run bot",
    "start:admin": "prisma migrate deploy --name init --skip-seed & bun run start & bun run bot:admin",
    "lint": "eslint \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "sort-imports": "eslint --fix \"src/**/*.ts\" \"prisma/script/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "fix": "bun run lint:fix && bun run format && bun run typecheck"
  },
  "prisma": {
    "seed": "bun ./prisma/script/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/graphql-yoga": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@graphql-tools/graphql-file-loader": "^8.0.14",
    "@graphql-tools/load": "^8.0.14",
    "@graphql-tools/schema": "^10.0.18",
    "@mtcute/bun": "^0.21.0",
    "@mtcute/core": "^0.21.1",
    "@mtcute/dispatcher": "^0.21.0",
    "@mtcute/tl": "^199.0.0",
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "elysia": "^1.2.12",
    "graphql": "^16.11.0",
    "graphql-tools": "^9.0.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.2.2",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "bun-types": "^1.2.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prisma": "^6.4.1",
    "telegram-bot-api-types": "^8.3.0",
    "typescript": "^5.7.3"
  }
}
