generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String
  accounts      Account[]
  sessions      Session[]
  lyrics        Lyrics[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Lyrics {
  id Int @id @default(autoincrement())

  lyricId        Int       @unique @map("lyric_id")
  date           DateTime
  editDate       DateTime?
  isPinned       Boolean   @map("is_pinned")
  isChannelPost  Boolean   @map("is_channel_post")
  replyToMessage Int?      @map("reply_to_message")

  message Message?
  user    UserLyric?
  chat    Chat?
  media   Media?

  userId Int  @map("user_id")
  owner  User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lyrics")
}

model Message {
  id Int @id @default(autoincrement())

  message_id      Int
  text            String?
  word_count      Int?
  paragraph_count Int?

  reactions Reactions?
  hashtags  Hashtags?

  lyric   Lyrics @relation(fields: lyricId, references: lyricId)
  lyricId Int    @unique @map("lyric_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("messages")
}

model Reactions {
  id Int @id @default(autoincrement())

  uniqueCount    Int @map("unique_count")
  totalFreeCount Int @map("total_free_count")
  totalPaidCount Int @map("total_paid_count")
  totalCount     Int @map("total_count")

  emojis Emoji[]

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique @map("message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reactions")
}

model Emoji {
  id Int @id @default(autoincrement())

  emoji  String
  isPaid Boolean @map("is_paid")
  count  Int
  order  Int?

  reaction   Reactions @relation(fields: [reactionId], references: [id])
  reactionId Int       @unique @map("reaction_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("emojis")
}

model UserLyric {
  key Int @id @default(autoincrement())

  id          BigInt  @db.BigInt
  username    String?
  displayName String? @map("display_name")
  isAdmin     Boolean @map("is_admin")

  lyrics  Lyrics @relation(fields: lyricId, references: lyricId)
  lyricId Int    @unique @map("lyric_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_lyrics")
}

model Chat {
  key Int @id @default(autoincrement())

  id    BigInt @db.BigInt
  title String
  type  String

  lyric   Lyrics @relation(fields: lyricId, references: lyricId)
  lyricId Int    @unique @map("lyric_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chats")
}

model Media {
  id Int @id @default(autoincrement())

  mime     String
  duration Int
  convert  Boolean

  lyric   Lyrics @relation(fields: lyricId, references: lyricId)
  lyricId Int    @unique @map("lyric_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media")
}

model Hashtags {
  id Int @id @default(autoincrement())

  tags  String[]
  count Int

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique @map("message_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hashtags")
}
