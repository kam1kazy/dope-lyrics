generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id Int @id @default(autoincrement())

  username String
  email    String
  password String

  lyrics Lyrics[]
}

model Lyrics {
  id Int @id @default(autoincrement())

  lyric_id       Int
  date           DateTime
  editDate       DateTime?
  isPinned       Boolean
  isChannelPost  Boolean
  /// Эталон каталога: ставит приложение (позже ИИ), не хештег из Telegram.
  isReference    Boolean  @default(false)
  /// Скрыто из обычной карусели; seed не сбрасывает.
  isHidden       Boolean  @default(false)
  /// Избранное для полки в drawer.
  isFavorite     Boolean  @default(false)
  /// Полка «цензура»: ставит приложение, seed не трогает.
  isCensored     Boolean  @default(false)
  /// Донор: сообщение разделили при склейке и спрятали; seed не трогает.
  isDonor        Boolean  @default(false)
  /// Авторский профиль: словари в lyric-facets.ts, seed не трогает.
  /// mood/delivery без роли; у каждой роли — свой набор в roleProfiles.
  mood           String[] @default([])
  delivery       String[] @default([])
  songRole       String[] @default([])
  roleProfiles   Json     @default("{}")
  readiness      String?
  replyToMessage Int?

  message Message?
  user    UserLyric?
  chat    Chat?
  media   Media?

  userId Int
  owner  Users @relation(fields: [userId], references: [id])

  @@index([lyric_id])
  @@index([date])
}

model Message {
  id Int @id @default(autoincrement())

  message_id      Int
  text            String?
  word_count      Int?
  paragraph_count Int?

  reactions Reactions?
  hashtags  Hashtags?

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Reactions {
  id Int @id @default(autoincrement())

  uniqueCount    Int
  totalFreeCount Int
  totalPaidCount Int
  totalCount     Int

  emojis Emoji[]

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique
}

model Emoji {
  id Int @id @default(autoincrement())

  emoji  String
  isPaid Boolean
  count  Int
  order  Int?

  reaction   Reactions @relation(fields: [reactionId], references: [id])
  reactionId Int
}

model UserLyric {
  key Int @id @default(autoincrement())

  id          BigInt
  username    String?
  displayName String?
  isAdmin     Boolean

  lyrics  Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Chat {
  key Int @id @default(autoincrement())

  id    BigInt
  title String
  type  String

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Media {
  id Int @id @default(autoincrement())

  mime     String
  duration Int
  convert  Boolean

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Hashtags {
  id Int @id @default(autoincrement())

  tags  String[]
  count Int

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique
}

/// Лайкнутая случайная склейка трека; seed не трогает.
model LyricCollage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  /// [{ songRole, parts: [{ lyricId, startLine, endLine }] }]. Старый shape { lyricId } ещё читается.
  slots     Json

  @@index([createdAt])
}

enum CarouselHistorySource {
  SHUFFLE
  QUEUE
  GENERATOR
  AI
}

/// Снимок порядка карусели; seed не трогает.
model CarouselHistory {
  id          Int                    @id @default(autoincrement())
  createdAt   DateTime               @default(now())
  source      CarouselHistorySource
  lyricIds    Int[]
  previewText String                 @default("")
  isLiked     Boolean                @default(false)

  @@index([createdAt])
  @@index([isLiked])
}
