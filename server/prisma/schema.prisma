generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  USER
}

model Users {
  id Int @id @default(autoincrement())

  username   String
  email      String?
  password   String?
  telegramId BigInt?  @unique
  role       UserRole @default(USER)

  lyrics          Lyrics[]
  collages        LyricCollage[]
  carouselHistory CarouselHistory[]
  sessions        Session[]
  channelBindings ChannelBinding[]
  aiPrompts       AiPrompt[]
  aiUsage         AiUsage[]
  trackTexts      TrackText[]
  invitesCreated  Invite[]          @relation("InviteCreatedBy")
  invitesUsed     Invite[]          @relation("InviteUsedBy")
}

enum LyricSource {
  TELEGRAM
  APPLE_NOTES
}

model Lyrics {
  id Int @id @default(autoincrement())

  lyric_id       Int
  /// Откуда запись: Telegram-чат или импорт Apple Notes. Не хештег.
  source         LyricSource @default(TELEGRAM)
  date           DateTime
  editDate       DateTime?
  isPinned       Boolean
  isChannelPost  Boolean
  /// Эталон каталога: ставит приложение (позже ИИ), не хештег из Telegram.
  isReference    Boolean     @default(false)
  /// Скрыто из обычной карусели; seed не сбрасывает.
  isHidden       Boolean     @default(false)
  /// Избранное для полки в drawer.
  isFavorite     Boolean     @default(false)
  /// Полка «цензура»: ставит приложение, seed не трогает.
  isCensored     Boolean     @default(false)
  /// Донор: сообщение разделили при склейке и спрятали; seed не трогает.
  isDonor        Boolean     @default(false)
  /// Уже брали в работу; подсветка, не скрытие. Seed не трогает.
  isUsed         Boolean     @default(false)
  /// Авторский профиль: словари в lyric-facets.ts, seed не трогает.
  /// mood/delivery без роли; у каждой роли — свой набор в roleProfiles.
  mood           String[]    @default([])
  delivery       String[]    @default([])
  songRole       String[]    @default([])
  roleProfiles   Json        @default("{}")
  readiness      String?
  /// Накал строки (шёпот…крик); seed не трогает.
  energy         String?
  replyToMessage Int?
  /// Чат Telegram записи (копия `Chat.id`): дубликаты считаются по паре чат + `lyric_id`.
  chatId         BigInt?

  message Message?
  user    UserLyric?
  chat    Chat?
  media   Media?

  userId Int
  owner  Users @relation(fields: [userId], references: [id])

  @@index([lyric_id])
  @@index([date])
  @@index([userId, date])
  @@index([userId, source, chatId, lyric_id])
}

model Message {
  id Int @id @default(autoincrement())

  message_id      Int
  text            String?
  word_count      Int?
  paragraph_count Int?

  reactions Reactions?
  hashtags  Hashtags?

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Reactions {
  id Int @id @default(autoincrement())

  uniqueCount    Int
  totalFreeCount Int
  totalPaidCount Int
  totalCount     Int

  emojis Emoji[]

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique
}

model Emoji {
  id Int @id @default(autoincrement())

  emoji  String
  isPaid Boolean
  count  Int
  order  Int?

  reaction   Reactions @relation(fields: [reactionId], references: [id])
  reactionId Int
}

model UserLyric {
  key Int @id @default(autoincrement())

  id          BigInt
  username    String?
  displayName String?
  isAdmin     Boolean

  lyrics  Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Chat {
  key Int @id @default(autoincrement())

  id    BigInt
  title String
  type  String

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Media {
  id Int @id @default(autoincrement())

  mime     String
  duration Int
  convert  Boolean

  lyric   Lyrics @relation(fields: lyricId, references: id)
  lyricId Int    @unique
}

model Hashtags {
  id Int @id @default(autoincrement())

  tags  String[]
  count Int

  message   Message @relation(fields: messageId, references: id)
  messageId Int     @unique
}

/// Лайкнутая случайная склейка трека; seed не трогает.
model LyricCollage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  /// [{ songRole, parts: [{ lyricId, startLine, endLine }] }]. Старый shape { lyricId } ещё читается.
  slots     Json

  userId Int
  owner  Users @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum CarouselHistorySource {
  SHUFFLE
  QUEUE
  GENERATOR
  AI
}

/// Снимок порядка карусели; seed не трогает.
model CarouselHistory {
  id          Int                   @id @default(autoincrement())
  createdAt   DateTime              @default(now())
  source      CarouselHistorySource
  lyricIds    Int[]
  previewText String                @default("")
  isLiked     Boolean               @default(false)

  userId Int
  owner  Users @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([isLiked])
  @@index([userId, createdAt])
}

model Session {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  owner Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id          Int       @id @default(autoincrement())
  codeHash    String    @unique
  createdById Int
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedById    Int?
  usedAt      DateTime?
  revokedAt   DateTime?

  createdBy Users  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    Users? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([createdById, createdAt])
}

model ChannelBinding {
  id        Int      @id @default(autoincrement())
  channelId BigInt   @unique
  userId    Int
  title     String?
  createdAt DateTime @default(now())

  owner Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AiUsageKind {
  COLLAGE_REWRITE
  PROMPT_META
}

enum AiUsageStatus {
  OK
  ERROR
}

/// Промпт автора: каждое создание — новая строка, текущий — последний.
model AiPrompt {
  id          Int      @id @default(autoincrement())
  text        String
  name        String?
  description String?
  createdAt   DateTime @default(now())

  userId Int
  owner  Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  usage      AiUsage[]
  trackTexts TrackText[]

  @@index([userId, createdAt])
}

/// Учёт вызова модели; пишется и на ошибку.
model AiUsage {
  id           Int           @id @default(autoincrement())
  kind         AiUsageKind
  model        String
  frameVersion Int
  tokensIn     Int           @default(0)
  tokensOut    Int           @default(0)
  /// Оценка по env-ценам; null — цена не задана.
  costRub      Decimal?      @db.Decimal(12, 4)
  latencyMs    Int
  status       AiUsageStatus
  error        String?
  createdAt    DateTime      @default(now())

  userId   Int
  owner    Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId Int?
  prompt   AiPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)

  trackTexts TrackText[]

  @@index([userId, createdAt])
}

/// Текст из генератора. sourceText и aiText после создания не меняются.
model TrackText {
  id         Int       @id @default(autoincrement())
  theme      String?
  /// Как у LyricCollage.slots.
  slots      Json
  sourceText String
  aiText     String
  text       String
  finalText  String?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId   Int
  owner    Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId Int?
  prompt   AiPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  usageId  Int?
  usage    AiUsage?  @relation(fields: [usageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
