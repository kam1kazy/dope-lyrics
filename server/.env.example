API_ID=
API_HASH=
BOT_TOKEN=
BOT_PHONE=
BOT_PASS=
BOT_CHAT_ID=
BOT_CHANNEL_ID=
BOT_ADMIN_ID=

DB_USER=
DB_NAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SCHEMA=
DB_CONTAINER=

DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"
PRISMA_MIGRATE_SKIP_NPM_RUN="true"

SITE_URL=
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_LIMIT=10000
BODY_LIMIT_BYTES=512000
NODE_ENV=development
PORT=4000
INGEST_URL=http://127.0.0.1:4071
INGEST_HOST=127.0.0.1
INGEST_PORT=4071
# Общий секрет backend ↔ бот; обязателен, если INGEST_HOST не loopback
INGEST_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
# ИИ (polza, OpenAI-совместимый). Пустой AI_API_KEY — ИИ выключен.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
AI_STYLE_EXAMPLES=25
# Цена за 1M токенов в рублях; 0 — сумму не считаем
AI_COST_RUB_PER_1M_IN=0
AI_COST_RUB_PER_1M_OUT=0
