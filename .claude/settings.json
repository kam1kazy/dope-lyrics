{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.prod)",
      "Read(./server/bot-data/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/.htpasswd)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(docker inspect:*)",
      "Bash(docker compose config:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)"
    ],
    "allow": [
      "Bash(git add *)",
      "Bash(git ls-remote *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git rev-list *)",
      "Bash(bun install:*)",
      "Bash(bun i:*)",
      "Bash(bun add:*)"
    ],
    "ask": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push * main)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(gh pr create:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-lint-edited-file.mjs\""
          }
        ]
      }
    ]
  }
}
